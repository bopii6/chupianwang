{
  "name": "chupianwang",
  "productName": "出片王",
  "version": "0.4.3",
  "description": "出片王：教培老师的视频获客工具",
  "author": "出片王",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "app": "electron .",
    "dist": "node scripts/build-python.mjs && electron-builder --win --x64",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@audio/encode-aac": "^1.2.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "electron-updater": "6.8.11",
    "fflate": "^0.8.3",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.5.0",
    "nodemailer": "^6.9.16",
    "opencc-js": "^1.4.2",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.chupianwang.desktop",
    "productName": "出片王",
    "copyright": "出片王",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "package.json",
      "server.js",
      "lib/**",
      "public/**",
      "prompts/**",
      "electron/**",
      "scripts/tts_batch.py",
      "文案库/违禁词.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/onnxruntime-web/dist/!(ort-wasm-simd-threaded.asyncify.*)",
      "!node_modules/@fontsource/noto-sans-sc/files/*.woff",
      "!node_modules/@fontsource/noto-sans-sc/files/*-{100,200,300,600,800}-normal.*",
      "!**/{CHANGELOG,README,readme,Readme}.md"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python"
      },
      {
        "from": ".cache/models/web/onnx-community/whisper-base",
        "to": "models/onnx-community/whisper-base"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "chupianwang-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "出片王",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bopii6",
        "repo": "chupianwang-releases",
        "releaseType": "release"
      }
    ]
  }
}
